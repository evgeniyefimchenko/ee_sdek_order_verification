<?xml version="1.0"?>
<addon scheme="4.0">
    <id>ee_sdek_order_verification</id>
    <version>2.0.0</version>
    <status>active</status>
    <auto_install>MULTIVENDOR,ULTIMATE</auto_install>
    <default_language>ru</default_language>
    
    <has_icon>Y</has_icon>
    <supplier>efimchenko.ru</supplier>
    <supplier_link>https://efimchenko.ru</supplier_link>
    <compatibility>
        <from_version>4.13.1</from_version>
    </compatibility>
    
    <settings layout="separate" edition_type="ROOT,VENDOR,STOREFRONT">
        <sections>
            <section id="general">
                <items>
                    <item id="enabled">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <item id="show_tracking">
                        <type>selectbox</type>
                        <default_value>none</default_value>
                        <variants>
                            <item id="none"/>
                            <item id="sdek"/>
                            <item id="mapped"/>
                        </variants>
                    </item>
                    <item id="hide_shipments">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <item id="login">
                        <type>input</type>
                        <required>Y</required>
                    </item>
                    <item id="password">
                        <type>password</type>
                        <required>Y</required>
                    </item>
                    <item id="test_mode">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <item id="batch_size">
                        <type>input</type>
                        <default_value>50</default_value>
                        <required>Y</required>
                    </item>
                    <item id="access_code">
                        <type>password</type>
                        <required>Y</required>
                    </item>
                    <item id="webhook_enabled">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <item id="connection_info">
                       <type>info</type>
                       <handler>fn_ee_sdek_get_connection_info</handler>
                    </item>
                    <item id="cron_info">
                       <type>info</type>
                       <handler>fn_ee_sdek_get_cron_info</handler>
                    </item>
                </items>
            </section>
            <section id="statuses_shipment">
                <items>
                    <item id="info_shipment_statuses">
                       <type>info</type>
                       <text>ee_sdek_order_verification_info_shipment_statuses</text>
                    </item>
                </items>
            </section>
            <section id="statuses_order">
                <items>
                    <item id="info_order_statuses">
                       <type>info</type>
                       <text>ee_sdek_order_verification_info_order_statuses</text>
                    </item>
                </items>
            </section>
            <section id="documentation">
                <items>
                    <item id="documentation_block"><type>template</type><default_value>documentation.tpl</default_value></item>
                </items>
            </section>
        </sections>
    </settings>
    <queries>
        <item for="install">
            CREATE TABLE IF NOT EXISTS ?:ee_sdek_history_status (
                order_id INT(11) UNSIGNED NOT NULL,
                shipment_id INT(11) UNSIGNED NOT NULL,
                statuses MEDIUMTEXT NOT NULL,
                last_update TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
                PRIMARY KEY (shipment_id),
                KEY order_id (order_id)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
        </item>
        <item for="uninstall">
            DROP TABLE IF EXISTS ?:ee_sdek_history_status;
        </item>
    </queries>
    <functions>
        <item for="install">fn_ee_sdek_order_verification_install</item>
        <item for="uninstall">fn_ee_sdek_order_verification_uninstall</item>
    </functions>
</addon>
